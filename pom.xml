<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.letslearnenglish</groupId>
    <artifactId>LetsLearnEnglish</artifactId>
    <version>1.0.7</version>
    <packaging>jar</packaging>

    <name>Let's Learn English!</name>
    <description>A Minecraft server plugin for gamified English learning</description>

    <!-- 许可与仓库根目录 LICENSE（GPL v3 全文）保持一致，并与 README / README-EN
         的许可证声明同步。 -->
    <licenses>
        <license>
            <name>GPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>GNU General Public License v3.0 only; full text in the repository LICENSE file.</comments>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 默认（无 profile）就是最广兼容的那一档：Java 21 + paper-api 1.21.4。
             26.x 那一档必须显式 -Pmc26 激活，因为它要求构建机有 JDK 25。 -->
        <java.version>21</java.version>
        <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
        <!-- 写进 plugin.yml 的 api-version 与产物名后缀，由 profile 覆盖 -->
        <plugin.api.version>1.21</plugin.api.version>
        <jar.suffix></jar.suffix>
        <junit.version>5.10.1</junit.version>
        <mockito.version>5.8.0</mockito.version>
        <!-- 仅测试用：真 SQLite 驱动（DatabaseManager 的维护/迁移测试需要真库）。
             运行期由 Paper 自带的 sqlite-jdbc（META-INF/libraries 内）提供，
             scope=test 保证不会进入插件 JAR，也不会与 shade 的 mysql 驱动同包。 -->
        <sqlite.jdbc.version>3.45.1.0</sqlite.jdbc.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MySQL JDBC Driver (optional, for MySQL database support) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 真 SQLite 驱动（仅测试）。运行期由 Paper 服务端自带的 sqlite-jdbc 提供，
             插件 JAR 不 shade 它——因此必须显式 test scope，否则会打进产物并
             与服务端版本产生类冲突（两套 native 库）。
             排除 slf4j-api：sqlite-jdbc 3.x 传递依赖 1.7.36，会与 paper-api 带来的
             2.0.x 在测试 classpath 上抢版本（当前靠声明顺序压住，改序即翻转）。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Vault API (optional, for economy integration) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (optional, for placeholder expansion) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}${jar.suffix}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <!-- 评审用词库样本，不随插件打包（详见 resources/words/README.md） -->
                    <exclude>words/sample-*.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.3</version>
                <configuration>
                    <!-- L19：显式 includes 会【覆盖】surefire 默认的四条模式，而不是追加。
                         原配置只留 **/*Test.java，等于把 Test*.java / *Tests.java /
                         *TestCase.java 三类命名静默排除在我们的构建之外（CI 与本地都不跑，
                         且不报错）。当前仓库全部测试都以 Test 结尾所以没漏，但只要有人按
                         Maven 惯例新建 TestXxx，就会被无声跳过。这里补回默认模式。 -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/Test*.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                    <!--
                      Mockito 的 Byte Buddy 官方只支持到 Java 22（class major 66）。
                      在 JDK 25 下跑测试（即 -Pmc26 那一档）会抛
                        IllegalArgumentException: Java 25 (69) is not supported
                      并让 213 个用到 mock 的测试全部 error —— 那是**测试基础设施**的
                      限制，不是被测代码的问题（业务代码在 Java 25 上编译运行都正常）。
                      这个属性让 Byte Buddy 跳过版本白名单，用同一套逻辑处理新字节码。
                      对 Java 21 构建没有任何影响（低版本本来就被支持）。
                    -->
                    <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                        Coverage gate (safety net). STARTING FLOOR ONLY.
                        Line coverage is ~4% today: most code is Bukkit-coupled and not yet
                        unit-tested, so the minimum is deliberately pinned very low (1%) just to
                        prove the gate runs green. Ratchet this up one notch every release as real
                        coverage grows. Do NOT jump to 50 percent, that would fail the build immediately.
                        Bound to the `verify` phase on purpose: it never fires during the team's
                        fast `mvn clean package -DskipTests` build, and jacoco:check skips cleanly
                        when execution data is absent (e.g. `verify -DskipTests`). Run `mvn verify`
                        to exercise the gate.
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.01</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

            <!--
                Shade 只打包 MySQL JDBC 驱动（P0-1：服主把 database.type 改成 mysql 后
                出现 ClassNotFoundException: com.mysql.cj.jdbc.Driver）。
                paper-api / VaultAPI / placeholderapi 均为 provided，不进入产物。
                不配置 relocations：驱动类名必须保持 com.mysql.cj.jdbc.Driver，
                且 META-INF/services/java.sql.Driver 内的服务声明也依赖原类名。
                本 execution 绑定 package，声明在 maven-jar-plugin 之后，故先由 jar 插件
                产出原始 jar（含 plugin.yml 与资源过滤结果），再由 shade 覆盖为该 jar。
                finalName 未改动，产物路径保持 target/${project.name}-${project.version}.jar。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>shade-mysql-driver</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.mysql:mysql-connector-j</include>
                                </includes>
                            </artifactSet>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>com.mysql:mysql-connector-j</artifact>
                                    <excludes>
                                        <!-- 签名文件并入 fat jar 会触发 SecurityException -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- 依赖自带索引在合并后失效，保留会误导类加载 -->
                                        <exclude>META-INF/INDEX.LIST</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- 依赖的清单/构建元数据不得覆盖插件自己的 MANIFEST.MF -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>INFO_BIN</exclude>
                                        <exclude>INFO_SRC</exclude>
                                        <!-- R-P2-6：驱动 jar 根的 LICENSE/README 会被置于产物根目录，
                                             语义上抢占"本插件许可证"位置（内容却是 Oracle 的）。
                                             排除之，改由 src/main/resources 内的项目 LICENSE /
                                             THIRD-PARTY-NOTICES.md 承担声明职责。 -->
                                        <exclude>LICENSE</exclude>
                                        <exclude>README</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- 保留并合并 META-INF/services/*（java.sql.Driver 自动注册依赖它） -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

<!-- ============================================================
     双构建：同一份源码，两档目标平台
     ============================================================

     为什么不合并成一个 JAR：Paper 的 API 是「编译期绑定」的 —— 用 1.21.4 的
     paper-api 编译，就只能引用 1.21.4 存在的方法；要用 26.x 的 API 就必须用
     26.x 的 paper-api 编译，而那要求构建机有 JDK 25。所以只能编两遍。

     关键事实（本机实测，不是推测）：
       - Java 21 编出的 class（major 65）在 Java 25 的 JVM 上能正常加载。
         Java 的向后兼容是单向的：新 JVM 跑得动旧字节码。
       - 把 1.21.4 编出的 JAR 放到 26.3 的 API classpath 上，插件主类的
         78 个方法全部解析成功（反射验证），说明源码本身与 26.x 兼容，
         缺的只是「用 26.x API 再编一遍」。
       - 26.3 的 apiVersioning.json 声明 currentApiVersion 为 26.3。

     产物与覆盖范围：
       mvn package          -> Let's Learn English!-<ver>.jar
                               MC 1.21.4 - 1.21.11 ｜ 需 Java 21+
       mvn package -Pmc26   -> Let's Learn English!-<ver>-mc26.jar
                               MC 26.1+（含 26.2 / 26.3 / 26.4）｜ 需 Java 25+
     ============================================================ -->
<profiles>
    <!-- 默认档不写成 profile，保持 mvn package 零参数行为不变；此处只定义 26.x 档 -->

    <profile>
        <id>mc26</id>
        <properties>
            <!-- 26.x 线用带构建号的 stable 版本：可复现，不像 SNAPSHOT 那样每天变 -->
            <paper.api.version>26.3.build.231-stable</paper.api.version>
            <!-- 26.x 要求 Java 25（class 文件 major 69） -->
            <java.version>25</java.version>
            <!--
              api-version 取 26.1 而不是 26.3：它声明的是「最低需要哪一代 API」，
              写得越低能跑的版本越多。26.1/26.2/26.3 属同一代（只做加法），
              所以 26.1 能让这一个 JAR 覆盖整条 26.x 线。
              若将来发现版本间有行为差异，再针对具体版本收紧。
              注意：这一点未经真实 26.1 服务端验证（手上只有 26.3 的 jar），
              已在 DEPLOYMENT_WIKI.md 如实标注。
            -->
            <plugin.api.version>26.1</plugin.api.version>
            <jar.suffix>-mc26</jar.suffix>
        </properties>
    </profile>
</profiles>
</project>
