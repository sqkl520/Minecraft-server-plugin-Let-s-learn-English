# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.jar

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
nbproject/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Backups / leftovers ----
*.bak
*.orig
*.rej
*~

# ---- Runtime / secrets (never commit) ----
# API key storage lives in the plugin data folder, but keep it out if copied here
ai_config.yml

# ---- Build/test scratch ----
build.log
jacoco.exec
.tmp-*/
# JVM 崩溃转储与诊断输出：构建/测试内存不足时 JVM 会在**工作目录**生成这些文件，
# 内含完整的内存映射、线程栈、jar 路径（可能带本机用户名/目录结构）。
# 它们对任何读者都无意义，且体积极大（单份 replay 日志可达数百 MB）。
hs_err_pid*.log
replay_pid*.log
*.hprof
javac.*.args

# Claude Code agent state (belongs in the parent dir, not the source repo)
.claude/

# ---- 内部工作记录（不随源码发布） ----
# tasks/ 是施工期的过程档案：Phase 计划、验收报告、dev-findings、锐评原稿，
# 以及若干对用户的直接引述（"用户原话：..."）。
# rules/project_rules.md 的上传清单只列了 5 项（Java 源码 / pom / README / CHANGELOG /
# LICENSE），本目录不在其中；它对外部读者没有意义，却会暴露内部流程细节。
# 保留在本地磁盘上（git rm --cached 而非 rm），需要时仍可查阅。
tasks/

# ralph/（自动化开发循环的 PRD / 进度流水 / 测试报告）已于 2026-11-17 删除，
# 本地备份在仓库外。保留这条规则是为了防止它被重新生成后再被误提交。
ralph/

# docs/reports/（逐轮的审计报告与缺陷台账）是内部工程记录，不进公开仓库。
# 理由同 tasks/：里面有内部流程词（评审轮次、Agent 交付）、本机路径、以及
# 「我哪里判断错了」这类只对自己有意义的复盘。round1–round30 从未入库，
# 保持这个惯例，不要让某一轮单独破例。
# 本地保留在仓库外的工作区 `Let's learn English!/docs/reports/` 下。
docs/reports/
