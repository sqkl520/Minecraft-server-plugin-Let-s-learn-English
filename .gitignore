# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.jar

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
nbproject/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Backups / leftovers ----
*.bak
*.orig
*.rej
*~

# ---- Runtime / secrets (never commit) ----
# API key storage lives in the plugin data folder, but keep it out if copied here
ai_config.yml

# ---- Build/test scratch ----
build.log
jacoco.exec
.tmp-*/
# JVM 崩溃转储与诊断输出：构建/测试内存不足时 JVM 会在**工作目录**生成这些文件，
# 内含完整的内存映射、线程栈、jar 路径（可能带本机用户名/目录结构）。
# 它们对任何读者都无意义，且体积极大（单份 replay 日志可达数百 MB）。
hs_err_pid*.log
replay_pid*.log
*.hprof
javac.*.args

# Claude Code agent state (belongs in the parent dir, not the source repo)
.claude/
