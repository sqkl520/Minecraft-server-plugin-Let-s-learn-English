# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.jar

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
nbproject/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Backups / leftovers ----
*.bak
*.orig
*.rej
*~

# ---- Runtime / secrets (never commit) ----
# API key storage lives in the plugin data folder, but keep it out if copied here
ai_config.yml

# ---- Build/test scratch ----
build.log
jacoco.exec
.tmp-*/
# JVM 崩溃转储与诊断输出：构建/测试内存不足时 JVM 会在**工作目录**生成这些文件，
# 内含完整的内存映射、线程栈、jar 路径（可能带本机用户名/目录结构）。
# 它们对任何读者都无意义，且体积极大（单份 replay 日志可达数百 MB）。
hs_err_pid*.log
replay_pid*.log
*.hprof
javac.*.args

# Claude Code agent state (belongs in the parent dir, not the source repo)
.claude/

# ---- 内部工作记录（不随源码发布） ----
# tasks/ 与 ralph/ 是施工期的过程档案：Phase 计划、验收报告、dev-findings、
# 锐评原稿、以及大量对用户的直接引述（"用户原话：..."）。
# rules/project_rules.md 的上传清单只列了 5 项（Java 源码 / pom / README / CHANGELOG /
# LICENSE），这两个目录不在其中；它们对任何外部读者都没有意义，却会暴露内部流程细节。
# 保留在本地磁盘上（git rm --cached 而非 rm），需要时仍可查阅。
tasks/
ralph/
